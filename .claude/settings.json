{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              ".claude/hooks/check-session-log.ps1"
            ],
            "timeout": 30,
            "statusMessage": "Checking docs/SESSION_LOG.md handoff entry"
          },
          {
            "type": "command",
            "command": "powershell",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              ".claude/hooks/check-handoff-file.ps1"
            ],
            "timeout": 30,
            "statusMessage": "Checking docs/handoffs/ file for today"
          }
        ]
      }
    ]
  }
}
