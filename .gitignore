# CMake build output
/cmake_gcc/build/
/build/
/artifact/
/artifacts/

# Compiled/linked build artifacts anywhere in the tree
*.o
*.d
*.map
*.bin
*.hex
*.axf
*.out
*.su
*.elf

# OS cruft
.DS_Store
Thumbs.db
desktop.ini

# Simplicity Studio local UI-editor cache (per-component canvas state,
# tied to the local machine path; not a build input, not part of the
# .slcp/pintool config record)
/.uceditor/

# Claude Code local session state. The session-handoff Stop hook and the
# settings that wire it up are project policy, not local state, so those two
# are tracked; settings.local.json (personal permission grants) stays ignored.
/.claude/*
!/.claude/settings.json
!/.claude/hooks/

# Simplicity Studio-generated per-machine files (user decision on the
# 2026-10-17_01 handoff's QUESTIONS FOR REVIEW). .projectlinkstore is
# deliberately NOT listed: it stays tracked even though it keeps showing as
# modified, because Studio metadata has broken this build before.
/.projectchecksums
/tilt_bed_controller_project.pdf
