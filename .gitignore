# CMake build output
/cmake_gcc/build/
/build/
/artifact/
/artifacts/

# Compiled/linked build artifacts anywhere in the tree
*.o
*.d
*.map
*.bin
*.hex
*.axf
*.out
*.su
*.elf

# OS cruft
.DS_Store
Thumbs.db
desktop.ini

# Simplicity Studio local UI-editor cache (per-component canvas state,
# tied to the local machine path; not a build input, not part of the
# .slcp/pintool config record)
/.uceditor/

# Claude Code local session state. The session-handoff Stop hook and the
# settings that wire it up are project policy, not local state, so those two
# are tracked; settings.local.json (personal permission grants) stays ignored.
/.claude/*
!/.claude/settings.json
!/.claude/hooks/
